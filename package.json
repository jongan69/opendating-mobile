  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "clean": "expo start --clear",
    "deploy:web": "echo 'Deploy via GitHub Pages — push to main and the deploy-web workflow handles the rest.'",
    "build:android": "eas build --profile production --platform android",
    "build:android:preview": "eas build --profile preview --platform android",
    "submit:android": "eas submit --profile production --platform android",
    "build:ios": "eas build --profile production --platform ios",
    "build:ios:preview": "eas build --profile preview --platform ios",
    "build:ios:screenshot": "eas build --profile screenshot --platform ios",
    "submit:ios": "eas submit --profile production --platform ios",
    "build:all": "eas build --profile production --platform all",
    "screenshots:capture": "./scripts/capture-screenshots.sh",
    "screenshots:capture:ios": "./scripts/capture-screenshots-ios.sh",
    "screenshots:resize": "./scripts/resize-screenshots.sh",
    "blog:generate": "node scripts/release/lib/generate-articles.mjs",
    "blog:build": "node scripts/release/lib/build-blog.mjs",
    "check:duplicates": "node scripts/check-duplicate-runtimes.mjs",
    "postinstall": "node scripts/check-duplicate-runtimes.mjs"
