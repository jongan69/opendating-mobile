# @nostr-dev-kit/ndk-mobile@0.8.43 declares a peer range of expo@^53 while this
# app targets the Expo 57 SDK. The package works against 57 — its peer range is
# simply stale — but a strict resolver refuses the tree outright, which fails a
# clean `npm install`/`npm ci` on EAS even though local development works.
#
# Pinning the resolution mode here keeps local installs, CI, and EAS builds
# identical instead of depending on whoever last ran npm with a manual flag.
# Revisit when ndk-mobile widens its peer range.
legacy-peer-deps=true
